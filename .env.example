POSTGRES_DB=codehub_rag
POSTGRES_USER=codehub
# Set a local password before starting Docker. Never commit .env.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Optional: DATABASE_URL takes precedence over individual connection settings.

# Optional for source-only preview; required for generated chat answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Set a long random token for a remotely hosted backend; same token on Vercel.
# Leave empty for the loopback-only local preview.
RAG_API_TOKEN=
RAG_MODEL_ROOT=data/models
RAG_ARTIFACT_ROOT=data/indexes

# Cloud deployment: Neon Connect -> pooled PostgreSQL URI (password included).
# This is separate from the local DATABASE_URL / POSTGRES_* settings above.
CLOUD_DATABASE_URL=
# SUPABASE_DATABASE_URL is also accepted for existing Supabase projects.
# Durable public demo request limits. OpenAI calls are still billed separately.
RAG_DAILY_LIMIT=100
RAG_HOURLY_IP_LIMIT=20
# Optional stable random salt for hashing client addresses; server-side only.
RAG_RATE_LIMIT_SALT=
